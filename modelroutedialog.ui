  <property name="styleSheet"><string notr="true">QDialog { background:#F4F7FB; }
QFrame#routeHeaderFrame, QFrame#routeListFrame, QFrame#routeInspectorFrame { background:#FFFFFF; border:1px solid #DDEBFA; border-radius:10px; }
QLabel#routeTitle { color:#14224A; font-size:22px; font-weight:700; }
QLabel#routeSubtitle, QLabel#routeDescriptionLabel, QLabel#profileHintLabel, QLabel#routeRuntimeLabel { color:#61728E; }
QLabel#routeTitleLabel { color:#1E315A; font-size:18px; font-weight:700; }
QLabel#capabilityLabel { color:#2563EB; background:#EEF5FF; border-radius:7px; padding:5px 8px; font-weight:600; }
QLabel#routeStatusNeutral, QLabel#routeStatusRunning, QLabel#routeStatusSuccess, QLabel#routeStatusError { border-radius:7px; padding:8px 10px; }
QLabel#routeStatusNeutral { background:#EEF4FC; color:#315A8E; }
QLabel#routeStatusRunning { background:#EEF4FF; color:#2563EB; }
QLabel#routeStatusSuccess { background:#ECFDF5; color:#047857; }
QLabel#routeStatusError { background:#FFF1F2; color:#BE123C; }
QLineEdit, QComboBox { background:#FFFFFF; border:1px solid #CBDCF4; border-radius:8px; padding:7px 10px; color:#1F3054; min-height:24px; }
QLineEdit:focus, QComboBox:focus { border:2px solid #4E87F5; }
QPushButton#saveButton { background:#2563EB; color:#FFFFFF; border:0; border-radius:8px; padding:9px 16px; font-weight:700; }
QPushButton#saveButton:hover { background:#1E55C8; }
QPushButton#saveButton:disabled { background:#AFC5EE; }
QPushButton#refreshButton, QPushButton#closeButton { background:#FFFFFF; color:#2563EB; border:1px solid #C9DCF8; border-radius:8px; padding:8px 14px; }
QPushButton#refreshButton:hover, QPushButton#closeButton:hover { background:#EEF6FF; }
QTableWidget { background:#FFFFFF; border:1px solid #E1EBF8; border-radius:8px; gridline-color:#E8EFF8; selection-background-color:#E7F0FF; selection-color:#1E3A5F; }
QHeaderView::section { background:#F6F9FD; color:#48617F; border:0; border-bottom:1px solid #E1EBF8; padding:8px; font-weight:700; }</string></property>

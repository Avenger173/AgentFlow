  <property name="minimumSize"><size><width>860</width><height>640</height></size></property>
  <property name="windowTitle"><string>资料深度分析</string></property>
  <property name="styleSheet"><string notr="true">QDialog { background:#F4F7FB; }
QFrame#headerFrame, QFrame#requestFrame, QFrame#executionFrame, QFrame#resultFrame, QFrame#scopePanel { background:#FFFFFF; border:1px solid #DDEBFA; border-radius:10px; }
QLabel#dialogTitle { color:#14224A; font-size:22px; font-weight:700; }
QLabel#dialogSubtitle, QLabel#requestHint, QLabel#scopeHint { color:#5D6F8C; }
QLabel#knowledgeBaseLabel { color:#2563EB; background:#EEF4FF; border-radius:10px; padding:5px 10px; font-weight:600; }
QLabel#statusBadge { color:#315A8E; background:#EEF4FC; border-radius:10px; padding:5px 9px; font-weight:600; }
QLabel#statusBadge[state=&quot;completed&quot;] { color:#067647; background:#ECFDF3; }
QLabel#statusBadge[state=&quot;paused&quot;], QLabel#statusBadge[state=&quot;blocked&quot;], QLabel#statusBadge[state=&quot;cancelled&quot;] { color:#A15C07; background:#FFF7E8; }
QLabel#statusBadge[state=&quot;failed&quot;] { color:#B42318; background:#FFF0EE; }
QTextEdit#taskGoalEdit, QComboBox#taskKindComboBox { background:#FFFFFF; border:1px solid #CBDCF4; border-radius:8px; padding:7px; color:#1F3054; }
QTextEdit#taskGoalEdit:focus, QComboBox#taskKindComboBox:focus { border:2px solid #4E87F5; }
QFrame#comparisonSelectionFrame { background:#F8FBFF; border:1px solid #DDEBFA; border-radius:8px; }
QListWidget#comparisonDocumentList { background:#FFFFFF; border:1px solid #CBDCF4; border-radius:7px; padding:3px; }
QListWidget#comparisonDocumentList::item { padding:6px 8px; border-radius:5px; }
QListWidget#comparisonDocumentList::item:selected { background:#EAF2FF; color:#1D4ED8; }
QTextBrowser#resultBrowser, QTextBrowser#scopeDetailBrowser { background:#F8FBFF; border:1px solid #DDEBFA; border-radius:8px; padding:12px; color:#1F3054; }
QTextBrowser#resultBrowser h1 { color:#14224A; margin:0 0 10px 0; }
QTextBrowser#resultBrowser h2, QTextBrowser#scopeDetailBrowser h2 { color:#1E315A; margin-top:14px; }
QListWidget#scopeList { background:#FFFFFF; border:1px solid #DDEBFA; border-radius:8px; padding:4px; }
QListWidget#scopeList::item { padding:8px; border-radius:6px; }
QListWidget#scopeList::item:selected { background:#EAF2FF; color:#1D4ED8; }
QPushButton#startDeepTaskButton, QPushButton#resumeButton:enabled, QPushButton#exportReportButton:enabled { background:#2563EB; color:#FFFFFF; border:1px solid #2563EB; border-radius:8px; padding:9px 16px; font-weight:700; }
QPushButton#startDeepTaskButton:hover, QPushButton#resumeButton:enabled:hover, QPushButton#exportReportButton:enabled:hover { background:#1D4ED8; border-color:#1D4ED8; }
QPushButton#startDeepTaskButton:pressed, QPushButton#resumeButton:enabled:pressed, QPushButton#exportReportButton:enabled:pressed { background:#1E40AF; border-color:#1E40AF; }
QPushButton#pauseButton:enabled, QPushButton#scopeToggleButton:enabled, QPushButton#historyButton:enabled, QPushButton#closeButton:enabled { background:#FFFFFF; color:#2563EB; border:1px solid #C9DCF8; border-radius:8px; padding:8px 13px; font-weight:600; }
QPushButton#pauseButton:enabled:hover, QPushButton#scopeToggleButton:enabled:hover, QPushButton#historyButton:enabled:hover, QPushButton#closeButton:enabled:hover { background:#EEF4FF; border-color:#8AB4F8; }
QPushButton#cancelButton:enabled { background:#FFF6F5; color:#B42318; border:1px solid #F1C2BE; border-radius:8px; padding:8px 13px; font-weight:600; }
QPushButton#cancelButton:enabled:hover { background:#FEECEB; border-color:#E78C86; }
QPushButton#startDeepTaskButton:disabled, QPushButton#pauseButton:disabled, QPushButton#resumeButton:disabled, QPushButton#cancelButton:disabled, QPushButton#scopeToggleButton:disabled, QPushButton#historyButton:disabled, QPushButton#exportReportButton:disabled, QPushButton#closeButton:disabled { background:#F1F5F9; color:#94A3B8; border:1px solid #E2E8F0; }
QPushButton#startDeepTaskButton:focus, QPushButton#pauseButton:focus, QPushButton#resumeButton:focus, QPushButton#cancelButton:focus, QPushButton#scopeToggleButton:focus, QPushButton#historyButton:focus, QPushButton#exportReportButton:focus, QPushButton#closeButton:focus { border:2px solid #60A5FA; }
QLabel#stageLabel { background:#EEF4FC; color:#315A8E; border-radius:7px; padding:8px 10px; }
QLabel#scopeCountLabel { color:#5D6F8C; background:#F1F5F9; border-radius:9px; padding:4px 8px; }</string></property>

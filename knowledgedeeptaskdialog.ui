   <item><widget class="QFrame" name="requestFrame"><layout class="QVBoxLayout" name="requestLayout"><property name="spacing"><number>8</number></property><property name="leftMargin"><number>18</number></property><property name="topMargin"><number>15</number></property><property name="rightMargin"><number>18</number></property><property name="bottomMargin"><number>15</number></property><item><layout class="QHBoxLayout" name="requestHeaderLayout"><item><widget class="QLabel" name="requestTitle"><property name="text"><string>这次需要完成什么？</string></property><property name="styleSheet"><string notr="true">font-size:16px; font-weight:700; color:#1E315A;</string></property></widget></item><item><spacer name="requestHeaderFill"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>30</width><height>20</height></size></property></spacer></item><item><widget class="QComboBox" name="taskKindComboBox"><property name="minimumSize"><size><width>170</width><height>36</height></size></property><property name="toolTip"><string>全库深度总结覆盖全部资料；资料对照表只处理你明确选择的资料。</string></property></widget></item></layout></item><item><widget class="QFrame" name="comparisonSelectionFrame"><property name="visible"><bool>false</bool></property><layout class="QVBoxLayout" name="comparisonSelectionLayout"><property name="spacing"><number>6</number></property><property name="leftMargin"><number>10</number></property><property name="topMargin"><number>9</number></property><property name="rightMargin"><number>10</number></property><property name="bottomMargin"><number>9</number></property><item><widget class="QLabel" name="comparisonSelectionTitle"><property name="text"><string>选择要对照的资料（2 至 12 份）</string></property><property name="styleSheet"><string notr="true">font-weight:700; color:#1E315A;</string></property></widget></item><item><widget class="QListWidget" name="comparisonDocumentList"><property name="minimumSize"><size><width>0</width><height>76</height></size></property><property name="maximumSize"><size><width>16777215</width><height>132</height></size></property><property name="selectionMode"><enum>QAbstractItemView::SelectionMode::ExtendedSelection</enum></property><property name="toolTip"><string>按 Ctrl 或 Shift 选择 2 至 12 份资料；最终对照表会按列表中的资料顺序排列。</string></property></widget></item></layout></widget></item><item><widget class="QTextEdit" name="taskGoalEdit"><property name="minimumSize"><size><width>0</width><height>72</height></size></property><property name="maximumSize"><size><width>16777215</width><height>104</height></size></property><property name="placeholderText"><string>例如：总结全部资料的关键结论、约束、待办与需要确认的问题。</string></property></widget></item><item><layout class="QHBoxLayout" name="requestActionLayout"><item><widget class="QLabel" name="requestHint"><property name="text"><string>将覆盖当前活动索引的全部资料；开始后资料更新不会混入本次任务。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item><spacer name="requestActionFill"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>34</width><height>20</height></size></property></spacer></item><item><widget class="QPushButton" name="startDeepTaskButton"><property name="minimumSize"><size><width>128</width><height>38</height></size></property><property name="text"><string>开始深度分析</string></property></widget></item></layout></item></layout></widget></item>
   <item><widget class="QFrame" name="executionFrame"><layout class="QVBoxLayout" name="executionLayout"><property name="spacing"><number>8</number></property><property name="leftMargin"><number>18</number></property><property name="topMargin"><number>12</number></property><property name="rightMargin"><number>18</number></property><property name="bottomMargin"><number>12</number></property><item><layout class="QHBoxLayout" name="executionHeaderLayout"><item><widget class="QLabel" name="executionTitle"><property name="text"><string>运行状态</string></property><property name="styleSheet"><string notr="true">font-weight:700; color:#1E315A;</string></property></widget></item><item><widget class="QLabel" name="statusBadge"><property name="text"><string>等待任务</string></property></widget></item><item><spacer name="executionFill"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>30</width><height>20</height></size></property></spacer></item><item><widget class="QPushButton" name="pauseButton"><property name="text"><string>暂停</string></property><property name="toolTip"><string>当前模型回合安全返回后暂停</string></property></widget></item><item><widget class="QPushButton" name="resumeButton"><property name="text"><string>继续</string></property><property name="toolTip"><string>从已保存的检查点继续</string></property></widget></item><item><widget class="QPushButton" name="cancelButton"><property name="text"><string>取消</string></property><property name="toolTip"><string>当前模型回合安全返回后停止后续章节</string></property></widget></item></layout></item><item><widget class="QLabel" name="stageLabel"><property name="text"><string>输入目标后，系统会显示冻结范围、Map 与 Reduce 的真实阶段。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item></layout></widget></item>

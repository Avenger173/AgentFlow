<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
<class>MainWindow</class>
<widget class="QMainWindow" name="MainWindow">
<property name="geometry"><rect><x>0</x><y>0</y><width>1500</width><height>940</height></rect></property>
<property name="minimumSize"><size><width>1280</width><height>820</height></size></property>
<property name="windowTitle"><string>AgentFlow AI工作台</string></property>
<property name="styleSheet"><string notr="true">
QMainWindow { background: #F4F7FB; }
QWidget {
    font-family: &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;;
    font-size: 14px;
    color: #1E293B;
}
QWidget#centralwidget { background: #F4F7FB; }
QFrame#sidebarFrame {
    background: #FFFFFF;
    border-right: 1px solid #E3ECF7;
}
QToolButton#sidebarCollapseButton {
    background: #F8FBFF;
    border: 1px solid #D9E7F6;
    border-radius: 12px;
    padding: 6px;
}
QToolButton#sidebarCollapseButton:hover {
    background: #EAF2FF;
    border-color: #9FC5FF;
}
QPushButton[compactNav="true"] {
    padding: 10px;
    text-align: center;
}
QFrame#mainFrame { background: #F4F7FB; }
QFrame#card, QFrame#sidePanel, QFrame#summaryCard, QFrame#contentCard {
    background: rgba(255, 255, 255, 245);
    border: 1px solid #DDEBFA;
    border-radius: 22px;
}
QFrame#heroCard,
QFrame#historyMainCard {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
                                stop:0 rgba(255,255,255,250),
                                stop:0.52 #F1F7FF,
                                stop:1 #E9FBFF);
    border: 1px solid #C8DEFF;
    border-radius: 22px;
}
QFrame#accentCard {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #2457E6, stop:0.48 #0EA5E9, stop:1 #10B981);
    border-radius: 30px;
}
QPushButton {
    border: 1px solid #D4E2F2;
    border-radius: 14px;
    padding: 10px 13px;
    min-height: 21px;
    background: #FFFFFF;
    color: #2563EB;
    text-align: center;
}
QPushButton:hover { background: #EEF6FF; color: #2563EB; }
QPushButton:disabled { background: #F8FAFC; border-color: #E2E8F0; color: #A0AEC0; }
QPushButton[active=&quot;true&quot;] {
    background: #2563EB;
    color: white;
    font-weight: 800;
}
QFrame#sidebarFrame QPushButton { border: none; background: transparent; color: #475569; text-align: left; }
QFrame#sidebarFrame QPushButton:hover { background: #EEF6FF; color: #2563EB; }
QFrame#sidebarFrame QPushButton[active=&quot;true&quot;] { background: #2563EB; color: #FFFFFF; font-weight: 800; }
QPushButton#primaryButton {
    background: #2563EB;
    color: white;
    font-weight: 800;
    border-radius: 16px;
    padding: 12px 20px;
    min-width: 105px;
    text-align: center;
}
QPushButton#primaryButton:hover { background: #1D4ED8; }
QPushButton#primaryButton:pressed { background: #1E40AF; }
QPushButton#primaryButton:disabled { background: #B9C9E8; color: #F8FAFC; }
QPushButton#ghostButton, QToolButton#ghostButton {
    background: #FFFFFF;
    border: 1px solid #D4E2F2;
    color: #2563EB;
    border-radius: 15px;
    text-align: center;
}
QPushButton#ghostButton:hover, QToolButton#ghostButton:hover { background: #EEF6FF; border-color: #9FC5FF; }
QPushButton#ghostButton:pressed, QToolButton#ghostButton:pressed { background: #DCEBFF; }
QPushButton#ghostButton:disabled, QToolButton#ghostButton:disabled { background: #F8FAFC; border-color: #E2E8F0; color: #A0AEC0; }
QToolButton#ghostButton::menu-button {
    width: 20px;
    border-left: 1px solid #E2E8F0;
}
QPushButton#secondaryButton {
    background: #EEF6FF;
    color: #2563EB;
    font-weight: 800;
    border-radius: 15px;
    text-align: center;
}
QPushButton#secondaryButton:hover { background: #DCEBFF; }
QPushButton#secondaryButton:pressed { background: #C7DEFF; }
QPushButton#secondaryButton:disabled { background: #F1F5F9; color: #94A3B8; }
QPushButton#dangerButton {
    background: #FEF2F2;
    color: #DC2626;
    border-radius: 15px;
    text-align: center;
}
QPushButton#dangerButton:hover { background: #FEE2E2; }
QPushButton#dangerButton:pressed { background: #FECACA; }
QPushButton#dangerButton:disabled { background: #F8FAFC; color: #CBD5E1; }
QPushButton#primaryButton:focus, QPushButton#secondaryButton:focus, QPushButton#ghostButton:focus, QPushButton#dangerButton:focus { border: 2px solid #60A5FA; }
QLabel#logoBadge {
    background: #2563EB;
    color: #FFFFFF;
    border-radius: 18px;
    font-size: 24px;
    font-weight: 900;
}
QLabel#avatarLabel {
    background: #DBEAFE;
    color: #2563EB;
    border-radius: 22px;
    font-weight: 900;
}
QLabel#brandTitle {
    font-size: 20px;
    font-weight: 900;
    color: #0F172A;
}
QLabel#navGroupTitle {
    color: #94A3B8;
    font-size: 12px;
    font-weight: 800;
    padding-left: 8px;
}
QLabel#pageTitle {
    font-size: 32px;
    font-weight: 900;
    color: #0F172A;
}
QLabel#heroTitle {
    font-size: 40px;
    font-weight: 900;
    color: #0B1220;
}
QLabel#sectionTitle {
    font-size: 18px;
    font-weight: 800;
    color: #0F172A;
}
QLabel#cardTitle {
    font-size: 16px;
    font-weight: 800;
    color: #111827;
}
QLabel#largeMetric {
    font-size: 28px;
    font-weight: 900;
    color: #2563EB;
}
QLabel#subText { color: #64748B; font-size: 13px; }
QLabel#tinyText { color: #94A3B8; font-size: 12px; }
QLabel#badgeBlue {
    background: #EAF2FF;
    color: #2563EB;
    border-radius: 11px;
    padding: 5px 11px;
    font-size: 12px;
    font-weight: 800;
}
QLabel#badgeGreen {
    background: #ECFDF5;
    color: #059669;
    border-radius: 11px;
    padding: 5px 11px;
    font-size: 12px;
    font-weight: 800;
}
QLabel#badgeGray {
    background: #F1F5F9;
    color: #64748B;
    border-radius: 11px;
    padding: 5px 11px;
    font-size: 12px;
    font-weight: 800;
}
QLabel#badgeOrange {
    background: #FFF7ED;
    color: #EA580C;
    border-radius: 11px;
    padding: 5px 11px;
    font-size: 12px;
    font-weight: 800;
}
QLabel#badgePurple {
    background: #F5F3FF;
    color: #7C3AED;
    border-radius: 11px;
    padding: 5px 11px;
    font-size: 12px;
    font-weight: 800;
}
QLineEdit {
    background: #FFFFFF;
    border: 1px solid #DCE8F6;
    border-radius: 16px;
    padding: 11px 16px;
    color: #1E293B;
}
QLineEdit:focus { border: 1px solid #60A5FA; }
QComboBox {
    background: #FFFFFF;
    border: 1px solid #DCE8F6;
    border-radius: 16px;
    padding: 9px 14px;
    color: #1E293B;
}
QComboBox:focus { border: 1px solid #60A5FA; }
QLineEdit#modelConfigBaseUrlInput,
QLineEdit#modelConfigModelInput,
QLineEdit#modelConfigApiKeyInput,
QComboBox#modelConfigThinkingCombo {
    padding: 6px 14px;
    border-radius: 15px;
}
QTextEdit, QTextBrowser {
    background: #F8FBFF;
    border: 1px solid #DFEAF6;
    border-radius: 18px;
    padding: 16px;
    color: #334155;
}
QTableWidget {
    background: #FFFFFF;
    border: 1px solid #DFEAF6;
    border-radius: 18px;
    gridline-color: #E8EFF8;
    selection-background-color: #EAF2FF;
    selection-color: #1E293B;
}
QTableWidget::item {
    padding: 8px 10px;
}
QListWidget {
    background: #FFFFFF;
    border: 1px solid #DFEAF6;
    border-radius: 16px;
    padding: 5px;
    outline: none;
}
QListWidget::item {
    border-radius: 10px;
    margin: 2px;
    padding: 9px 10px;
}
QListWidget::item:hover { background: #F4F8FF; }
QListWidget::item:selected {
    background: #EAF2FF;
    color: #1D4ED8;
    font-weight: 800;
}
QFrame#knowledgeVectorPanel {
    background: #F8FBFF;
    border: 1px solid #DCEBFA;
    border-radius: 16px;
}
QFrame#knowledgeOcrPanel {
    background: #F9FCFA;
    border: 1px solid #D8EEE1;
    border-radius: 16px;
}
QHeaderView::section {
    background: #F8FBFF;
    color: #475569;
    border: none;
    border-bottom: 1px solid #DDE8F5;
    padding: 10px 8px;
    font-weight: 800;
}
QWidget#historyConfirmationSection {
    background: #FFF8F1;
    border: 1px solid #FCD9B8;
    border-radius: 14px;
}
QLabel#historyConfirmationIcon {
    background: #FFF0E5;
    border-radius: 14px;
}
QToolButton#historyConfirmationToggleButton {
    background: #FFFFFF;
    border: 1px solid #F3D7BE;
    border-radius: 10px;
    padding: 4px;
}
QToolButton#historyConfirmationToggleButton:hover {
    background: #FFF7ED;
}
QTextEdit#historyConfirmationText {
    background: #FFFFFF;
    border: 1px solid #F5D7BC;
    border-radius: 12px;
    padding: 8px;
}
QWidget#historyRuntimeStrip {
    background: rgba(248,251,255,220);
    border: 1px solid #DDE8F5;
    border-radius: 12px;
}
QWidget#historyArtifactStrip {
    background: rgba(248,251,255,220);
    border: 1px solid #DDE8F5;
    border-radius: 12px;
}
QWidget#historyArtifactStrip QComboBox {
    padding: 4px 10px;
    border-radius: 10px;
}
QWidget#historyArtifactStrip QToolButton {
    background: #FFFFFF;
    border: 1px solid #DCE8F6;
    border-radius: 11px;
    padding: 5px;
}
QWidget#historyArtifactStrip QToolButton:hover {
    background: #EEF6FF;
    border-color: #BFD7FF;
}
QProgressBar {
    border: none;
    background: #EAF0F7;
    border-radius: 7px;
    height: 12px;
    color: transparent;
}

QFrame#blueGlowCard {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
                                stop:0 rgba(37,99,235,60),
                                stop:1 rgba(14,165,233,18));
    border: 1px solid rgba(37,99,235,45);
    border-radius: 34px;
}
QFrame#greenGlowCard {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
                                stop:0 rgba(20,184,166,50),
                                stop:1 rgba(34,197,94,18));
    border: 1px solid rgba(20,184,166,38);
    border-radius: 34px;
}
QFrame#purpleGlowCard {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
                                stop:0 rgba(124,58,237,44),
                                stop:1 rgba(236,72,153,16));
    border: 1px solid rgba(124,58,237,34);
    border-radius: 30px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #2563EB, stop:1 #14B8A6);
    border-radius: 7px;
}

QPushButton#navGroupButton {
    background: transparent;
    color: #94A3B8;
    font-size: 12px;
    font-weight: 900;
    padding: 8px 8px;
    text-align: left;
}
QPushButton#navGroupButton:hover {
    background: #F8FAFC;
    color: #64748B;
}


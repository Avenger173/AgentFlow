  <property name="windowTitle"><string>向资料提问</string></property>
  <property name="styleSheet"><string notr="true">QDialog { background:#F4F7FB; }
QFrame#headerFrame, QFrame#questionFrame, QFrame#resultFrame, QFrame#sourcePanel { background:#FFFFFF; border:1px solid #DDEBFA; border-radius:10px; }
QLabel#dialogTitle { color:#14224A; font-size:22px; font-weight:700; }
QLabel#dialogSubtitle, QLabel#questionHint, QLabel#sourceHint { color:#5D6F8C; }
QLabel#knowledgeBaseLabel { color:#2563EB; background:#EEF4FF; border-radius:10px; padding:5px 10px; font-weight:600; }
QTextEdit#questionEdit { background:#FFFFFF; border:1px solid #CBDCF4; border-radius:8px; padding:8px; color:#1F3054; }
QTextEdit#questionEdit:focus { border:2px solid #4E87F5; }
QTextBrowser#answerBrowser, QTextBrowser#sourceDetail { background:#F8FBFF; border:1px solid #DDEBFA; border-radius:8px; padding:12px; color:#1F3054; }
QTextBrowser#answerBrowser h1 { color:#14224A; margin:0 0 10px 0; }
QTextBrowser#answerBrowser h2, QTextBrowser#sourceDetail h2 { color:#1E315A; margin-top:14px; }
QListWidget#sourceList { background:#FFFFFF; border:1px solid #DDEBFA; border-radius:8px; padding:4px; }
QListWidget#sourceList::item { padding:8px; border-radius:6px; }
QListWidget#sourceList::item:selected { background:#EAF2FF; color:#1D4ED8; }
QPushButton#askButton { background:#2563EB; color:#FFFFFF; border:0; border-radius:8px; padding:9px 16px; font-weight:700; }
QPushButton#askButton:hover { background:#1E55C8; }
QPushButton#askButton:disabled { background:#AFC5EE; }
QPushButton#sourceToggleButton, QPushButton#historyButton, QPushButton#closeButton { background:#FFFFFF; color:#2563EB; border:1px solid #C9DCF8; border-radius:8px; padding:8px 13px; }
QLabel#stageLabel { background:#EEF4FC; color:#315A8E; border-radius:7px; padding:8px 10px; }
QLabel#evidenceBadge { background:#EEF4FF; color:#2563EB; border-radius:10px; padding:5px 9px; font-weight:600; }
QLabel#sourceCountLabel { color:#5D6F8C; background:#F1F5F9; border-radius:9px; padding:4px 8px; }</string></property>
  <layout class="QVBoxLayout" name="mainLayout">

   <item><widget class="QFrame" name="questionFrame"><layout class="QVBoxLayout" name="questionLayout"><property name="spacing"><number>8</number></property><property name="leftMargin"><number>18</number></property><property name="topMargin"><number>16</number></property><property name="rightMargin"><number>18</number></property><property name="bottomMargin"><number>16</number></property><item><widget class="QLabel" name="questionTitle"><property name="text"><string>你想确认什么？</string></property><property name="styleSheet"><string notr="true">font-size:16px; font-weight:700; color:#1E315A;</string></property></widget></item><item><widget class="QTextEdit" name="questionEdit"><property name="minimumSize"><size><width>0</width><height>76</height></size></property><property name="maximumSize"><size><width>16777215</width><height>104</height></size></property><property name="placeholderText"><string>例如：当前方案的验收要求是什么？与另一份资料有哪些差异？</string></property></widget></item><item><layout class="QHBoxLayout" name="questionActionLayout"><item><widget class="QLabel" name="questionHint"><property name="text"><string>系统会先检索并核验来源；资料不足时会明确停止，不会补写猜测。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item><spacer name="questionActionFill"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>36</width><height>20</height></size></property></spacer></item><item><widget class="QPushButton" name="askButton"><property name="minimumSize"><size><width>116</width><height>38</height></size></property><property name="text"><string>开始检索</string></property></widget></item></layout></item></layout></widget></item>

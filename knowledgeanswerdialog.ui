><width>16777215</width><height>190</height></size></property><property name="selectionMode"><enum>QAbstractItemView::SelectionMode::SingleSelection</enum></property></widget></item><item><widget class="QTextBrowser" name="sourceDetail"><property name="minimumSize"><size><width>0</width><height>150</height></size></property><property name="openExternalLinks"><bool>false</bool></property><property name="markdown"><string>选择一条来源后，可查看其文件、位置与短片段。</string></property></widget></item></layout></widget></widget></item><item><layout class="QHBoxLayout" name="resultFooterLayout"><item><widget class="QPushButton" name="historyButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>查看任务历史</string></property></widget></item><item><spacer name="resultFooterFill"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item><item><widget class="QPushButton" name="closeButton"><property name="text"><string>关闭</string></property></widget></item></layout></item></layout></widget></item>

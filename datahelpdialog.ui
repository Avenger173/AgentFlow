  <property name="windowTitle"><string>数据工作台使用说明</string></property>
  <property name="styleSheet"><string notr="true">QDialog { background:#F4F7FB; }
QFrame#headerFrame, QFrame#guideFrame { background:#FFFFFF; border:1px solid #DDEBFA; border-radius:10px; }
QFrame#stepCardOne, QFrame#stepCardTwo, QFrame#stepCardThree { background:#F8FBFF; border:1px solid #E3EDF9; border-radius:8px; }
QFrame#exampleFrame { background:#EEF6FF; border:1px solid #D8E8FF; border-radius:8px; }
QLabel#helpTitle { color:#14224A; font-size:22px; font-weight:700; }
QLabel#helpSubtitle, QLabel#stepDetailOne, QLabel#stepDetailTwo, QLabel#stepDetailThree, QLabel#boundaryText { color:#61728E; }
QLabel#stepNumberOne, QLabel#stepNumberTwo, QLabel#stepNumberThree { color:#1D4ED8; font-weight:700; background:#DBEAFE; border-radius:12px; padding:4px 8px; }
QLabel#stepTitleOne, QLabel#stepTitleTwo, QLabel#stepTitleThree { color:#1E315A; font-size:15px; font-weight:700; }
QLabel#exampleTitle { color:#1D4ED8; font-weight:700; }
QLabel#exampleTextOne, QLabel#exampleTextTwo { color:#1E3A5F; background:#FFFFFF; border:1px solid #D8E8FF; border-radius:6px; padding:7px 9px; }</string></property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="spacing"><number>12</number></property>
   <property name="leftMargin"><number>22</number></property><property name="topMargin"><number>20</number></property><property name="rightMargin"><number>22</number></property><property name="bottomMargin"><number>18</number></property>
   <item>
    <widget class="QFrame" name="headerFrame">
     <layout class="QHBoxLayout" name="headerLayout">
      <property name="leftMargin"><number>18</number></property><property name="topMargin"><number>14</number></property><property name="rightMargin"><number>18</number></property><property name="bottomMargin"><number>14</number></property>
      <item><widget class="QLabel" name="helpIcon"><property name="minimumSize"><size><width>44</width><height>44</height></size></property><property name="alignment"><set>Qt::AlignmentFlag::AlignCenter</set></property></widget></item>
      <item><layout class="QVBoxLayout" name="headerTextLayout"><property name="spacing"><number>2</number></property><item><widget class="QLabel" name="helpTitle"><property name="text"><string>从一张表到清晰结论</string></property></widget></item><item><widget class="QLabel" name="helpSubtitle"><property name="text"><string>不用先懂字段或图表；从你想解决的问题开始。</string></property></widget></item></layout></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QFrame" name="guideFrame">
     <layout class="QVBoxLayout" name="guideLayout">
      <property name="spacing"><number>12</number></property><property name="leftMargin"><number>16</number></property><property name="topMargin"><number>16</number></property><property name="rightMargin"><number>16</number></property><property name="bottomMargin"><number>16</number></property>
      <item><widget class="QLabel" name="guideTitle"><property name="text"><string>三步完成一次分析</string></property><property name="styleSheet"><string notr="true">font-size:16px;font-weight:700;color:#1E315A;</string></property></widget></item>
      <item>
       <layout class="QHBoxLayout" name="stepsLayout"><property name="spacing"><number>10</number></property>
        <item><widget class="QFrame" name="stepCardOne"><layout class="QVBoxLayout" name="stepOneLayout"><property name="spacing"><number>6</number></property><property name="leftMargin"><number>12</number></property><property name="topMargin"><number>12</number></property><property name="rightMargin"><number>12</number></property><property name="bottomMargin"><number>12</number></property><item><widget class="QLabel" name="stepNumberOne"><property name="text"><string>1</string></property><property name="alignment"><set>Qt::AlignmentFlag::AlignCenter</set></property><property name="maximumSize"><size><width>28</width><height>28</height></size></property></widget></item><item><widget class="QLabel" name="stepTitleOne"><property name="text"><string>导入一份表</string></property></widget></item><item><widget class="QLabel" name="stepDetailOne"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>支持 CSV 或 Excel。系统先检查字段、编码与数据质量。</string></property></widget></item></layout></widget></item>
        <item><widget class="QFrame" name="stepCardTwo"><layout class="QVBoxLayout" name="stepTwoLayout"><property name="spacing"><number>6</number></property><property name="leftMargin"><number>12</number></property><property name="topMargin"><number>12</number></property><property name="rightMargin"><number>12</number></property><property name="bottomMargin"><number>12</number></property><item><widget class="QLabel" name="stepNumberTwo"><property name="text"><string>2</string></property><property name="alignment"><set>Qt::AlignmentFlag::AlignCenter</set></property><property name="maximumSize"><size><width>28</width><height>28</height></size></property></widget></item><item><widget class="QLabel" name="stepTitleTwo"><property name="text"><string>说出想了解什么</string></property></widget></item><item><widget class="QLabel" name="stepDetailTwo"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>直接说趋势、对比或质量问题；不必先选择图表类型。</string></property></widget></item></layout></widget></item>
        <item><widget class="QFrame" name="stepCardThree"><layout class="QVBoxLayout" name="stepThreeLayout"><property name="spacing"><number>6</number></property><property name="leftMargin"><number>12</number></property><property name="topMargin"><number>12</number></property><property name="rightMargin"><number>12</number></property><property name="bottomMargin"><number>12</number></property><item><widget class="QLabel" name="stepNumberThree"><property name="text"><string>3</string></property><property name="alignment"><set>Qt::AlignmentFlag::AlignCenter</set></property><property name="maximumSize"><size><width>28</width><height>28</height></size></property></widget></item><item><widget class="QLabel" name="stepTitleThree"><property name="text"><string>阅读结论，再交付</string></property></widget></item><item><widget class="QLabel" name="stepDetailThree"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>先看结论与图表。需要时再保存 PNG 或创建含新增字段的数据副本。</string></property></widget></item></layout></widget></item>
       </layout>
      </item>
      <item><widget class="QFrame" name="exampleFrame"><layout class="QVBoxLayout" name="exampleLayout"><property name="spacing"><number>7</number></property><property name="leftMargin"><number>12</number></property><property name="topMargin"><number>11</number></property><property name="rightMargin"><number>12</number></property><property name="bottomMargin"><number>11</number></property><item><widget class="QLabel" name="exampleTitle"><property name="text"><string>可以这样提问</string></property></widget></item><item><widget class="QLabel" name="exampleTextOne"><property name="text"><string>绘制焦点位置与有效清晰度的变化曲线</string></property></widget></item><item><widget class="QLabel" name="exampleTextTwo"><property name="text"><string>按月份查看销售额趋势，并对比各区域表现</string></property></widget></item></layout></widget></item>
      <item><widget class="QLabel" name="boundaryText"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>字段加工只会创建一份新副本，在原数据后追加你确认的字段；不会覆盖源文件，也不会替你联网补数。</string></property></widget></item>
     </layout>
    </widget>

QLabel#statusNeutral { background:#EEF4FC; color:#315A8E; }
QLabel#statusRunning { background:#EEF4FF; color:#2563EB; }
QLabel#statusError { background:#FFF1F2; color:#BE123C; }
QComboBox { background:#FFFFFF; border:1px solid #CBDCF4; border-radius:8px; padding:7px 10px; min-height:24px; color:#1F3054; }
QComboBox:focus { border:2px solid #4E87F5; }
QPushButton#applyButton { background:#2563EB; color:#FFFFFF; border:0; border-radius:8px; padding:9px 16px; font-weight:700; }
QPushButton#applyButton:hover { background:#1E55C8; }
QPushButton#applyButton:disabled { background:#AFC5EE; }
QPushButton#refreshButton, QPushButton#cancelButton { background:#FFFFFF; color:#2563EB; border:1px solid #C9DCF8; border-radius:8px; padding:8px 14px; }
QPushButton#refreshButton:hover, QPushButton#cancelButton:hover { background:#EEF6FF; }</string></property>

<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PresentationStudioDialog</class>
 <widget class="QDialog" name="PresentationStudioDialog">
  <property name="windowModality"><enum>Qt::WindowModality::WindowModal</enum></property>
  <property name="geometry"><rect><x>0</x><y>0</y><width>1180</width><height>920</height></rect></property>
  <property name="minimumSize"><size><width>860</width><height>780</height></size></property>
  <property name="windowTitle"><string>智能制作 PPT</string></property>
  <property name="styleSheet"><string notr="true">QDialog { background:#F4F7FB; }
QFrame#heroFrame, QFrame#inputFrame, QFrame#planFrame { background:#FFFFFF; border:1px solid #DDEBFA; border-radius:10px; }
QLabel#heroTitle { color:#14224A; font-size:22px; font-weight:700; }
QLabel#heroSubtitle, QLabel#inputHint { color:#5D6F8C; }
QTextEdit#intentEdit, QLineEdit#filenameEdit { background:#FFFFFF; border:1px solid #CBDCF4; border-radius:8px; padding:8px; color:#1F3054; }
QTextEdit#intentEdit:focus, QLineEdit#filenameEdit:focus { border:2px solid #4E87F5; }
QTextBrowser#planPreview { background:#F8FBFF; border:1px solid #DDEBFA; border-radius:8px; padding:12px; color:#1F3054; }
QTextBrowser#planPreview h2 { color:#14224A; margin:0 0 6px 0; }
QTextBrowser#planPreview h3 { color:#1E315A; margin-top:16px; }
QTextBrowser#planPreview h4 { color:#1E315A; margin-bottom:3px; }
QTextBrowser#planPreview section { border-top:1px solid #E7EFFB; padding-top:5px; margin-top:8px; }
QTextBrowser#planPreview .studio-chip { color:#2563EB; font-weight:600; }
QTextBrowser#planPreview .studio-warning { color:#A24F2A; background:#FFF5E9; padding:8px; }
QTextBrowser#planPreview .studio-muted { color:#7B8CA7; }
QTextBrowser#planPreview .studio-action { color:#285A92; background:#EDF5FF; border:1px solid #D6E7FE; padding:9px; }
QPushButton#planButton, QPushButton#exportButton { background:#2563EB; color:#FFFFFF; border:0; border-radius:8px; padding:9px 16px; font-weight:700; }
QPushButton#planButton:hover, QPushButton#exportButton:hover { background:#1E55C8; }
QPushButton#planButton:disabled, QPushButton#exportButton:disabled { background:#AFC5EE; }
QPushButton#historyButton, QPushButton#closeButton { background:#FFFFFF; color:#2563EB; border:1px solid #C9DCF8; border-radius:8px; padding:8px 14px; }
QLabel#statusLabel { background:#EEF4FC; color:#315A8E; border-radius:7px; padding:7px 10px; }
QFrame#exportArea { border-top:1px solid #E4EDF9; }
QCheckBox#licensedAssetsCheckBox { color:#315A8E; spacing:7px; }
QCheckBox#licensedAssetsCheckBox::indicator { width:17px; height:17px; }
QCheckBox#licensedAssetsCheckBox::indicator:checked { background:#2563EB; border:1px solid #2563EB; border-radius:4px; }
QComboBox#visualAssetProviderCombo { background:#FFFFFF; color:#315A8E; border:1px solid #CBDCF4; border-radius:8px; padding:7px 28px 7px 10px; min-height:22px; }
QComboBox#visualAssetProviderCombo:hover { border-color:#7EA7EF; }
QComboBox#visualAssetProviderCombo:focus { border:2px solid #4E87F5; }
QComboBox#visualAssetProviderCombo::drop-down { border:0; width:24px; }</string></property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>12</number></property>
   <property name="leftMargin"><number>22</number></property>
   <property name="topMargin"><number>20</number></property>
   <property name="rightMargin"><number>22</number></property>
   <property name="bottomMargin"><number>20</number></property>
   
   <item><widget class="QFrame" name="heroFrame"><layout class="QHBoxLayout" name="heroLayout"><property name="leftMargin"><number>18</number></property><property name="topMargin"><number>14</number></property><property name="rightMargin"><number>18</number></property><property name="bottomMargin"><number>14</number></property><item><widget class="QLabel" name="studioIcon"><property name="minimumSize"><size><width>40</width><height>40</height></size></property><property name="alignment"><set>Qt::AlignmentFlag::AlignCenter</set></property></widget></item><item><layout class="QVBoxLayout" name="heroTextLayout"><property name="spacing"><number>2</number></property><item><widget class="QLabel" name="heroTitle"><property name="text"><string>智能制作 PPT</string></property></widget></item><item><widget class="QLabel" name="heroSubtitle"><property name="text"><string>说清你想做什么，系统先生成创作简报和逐页计划</string></property></widget></item></layout></item><item><spacer name="heroSpacer"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item><item><widget class="QLabel" name="modeLabel"><property name="text"><string>先计划 · 再确认导出</string></property><property name="styleSheet"><string notr="true">color:#2563EB; background:#EEF4FF; border-radius:12px; padding:5px 10px; font-weight:600;</string></property></widget></item></layout></widget></item>
   <item><widget class="QFrame" name="inputFrame"><property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Maximum"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property><layout class="QVBoxLayout" name="inputLayout"><property name="spacing"><number>8</number></property><property name="leftMargin"><number>18</number></property><property name="topMargin"><number>16</number></property><property name="rightMargin"><number>18</number></property><property name="bottomMargin"><number>16</number></property><item><widget class="QLabel" name="inputTitle"><property name="text"><string>这次想做什么？</string></property><property name="styleSheet"><string notr="true">font-size:16px; font-weight:700; color:#1E315A;</string></property></widget></item><item><widget class="QTextEdit" name="intentEdit"><property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property><property name="minimumSize"><size><width>0</width><height>96</height></size></property><property name="maximumSize"><size><width>16777215</width><height>96</height></size></property><property name="placeholderText"><string>例如：给潜在客户做一份关于 AI 文档交付平台的商务方案 PPT</string></property></widget></item><item><layout class="QHBoxLayout" name="inputActionLayout"><item><widget class="QLabel" name="inputHint"><property name="text"><string>系统会自动判断受众、叙事和版式；关键事实仍需在导出前确认。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item><widget class="QCheckBox" name="licensedAssetsCheckBox"><property name="toolTip"><string>计划阶段不联网；确认导出时才会从固定 Wikimedia 接口读取最多 3 条公开资料参考，写入来源页与任务历史。它不自动生成统计数据或结论。</string></property><property name="text"><string>导出时补充公开资料来源</string></property><property name="checked"><bool>false</bool></property></widget></item><item><spacer name="inputActionSpacer"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>30</width><height>20</height></size></property></spacer></item><item><widget class="QPushButton" name="planButton"><property name="minimumSize"><size><width>124</width><height>38</height></size></property><property name="text"><string>生成创作计划</string></property></widget></item></layout></item></layout></widget></item>
   <item><widget class="QFrame" name="planFrame"><property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy></property><layout class="QVBoxLayout" name="planLayout"><property name="spacing"><number>9</number></property><property name="leftMargin"><number>18</number></property><property name="topMargin"><number>16</number></property><property name="rightMargin"><number>18</number></property><property name="bottomMargin"><number>16</number></property><item><widget class="QLabel" name="statusLabel"><property name="text"><string>输入一句主题后，系统会先生成可确认的演示计划。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item><widget class="QTextBrowser" name="planPreview"><property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy></property><property name="minimumSize"><size><width>0</width><height>180</height></size></property><property name="openExternalLinks"><bool>false</bool></property><property name="html"><string>&lt;html&gt;&lt;body&gt;&lt;p class=&quot;studio-muted&quot;&gt;计划将在这里展示。&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property></widget></item><item><widget class="QFrame" name="exportArea"><property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Maximum"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property><layout class="QVBoxLayout" name="exportAreaLayout"><property name="spacing"><number>8</number></property><property name="leftMargin"><number>0</number></property><property name="topMargin"><number>10</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property><item><layout class="QHBoxLayout" name="exportLayout"><item><widget class="QLabel" name="filenameLabel"><property name="text"><string>交付文件名</string></property></widget></item><item><widget class="QLineEdit" name="filenameEdit"><property name="enabled"><bool>false</bool></property><property name="placeholderText"><string>生成计划后可命名 .pptx 文件</string></property></widget></item><item><widget class="QPushButton" name="exportButton"><property name="minimumSize"><size><width>112</width><height>38</height></size></property><property name="enabled"><bool>false</bool></property><property name="text"><string>确认导出</string></property></widget></item></layout></item><item><layout class="QHBoxLayout" name="footerActionsLayout"><item><widget class="QPushButton" name="historyButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>查看任务历史</string></property></widget></item><item><spacer name="footerSpacer"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item><item><widget class="QPushButton" name="closeButton"><property name="text"><string>关闭</string></property></widget></item></layout></item></layout></widget></item></layout></widget></item>
